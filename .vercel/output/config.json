{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/clock/?(?:/__data.json)?$",
			"dest": "/clock"
		},
		{
			"src": "^(/[^]*)?/?$",
			"dest": "/[...op]?__pathname=/$1"
		},
		{
			"src": "^(/[^]*)?/?/__data.json$",
			"dest": "/[...op]/__data.json?__pathname=/$1"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}